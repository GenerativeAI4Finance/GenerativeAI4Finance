# Copy to .env and fill in INFLUXDB3_TOKEN. .env is gitignored -- keep it that way.
# The token is referenced only as ${env:INFLUXDB3_TOKEN} in config.yaml; never
# inline it there, in a URL, or in a compose `environment:` block (those show up
# in `docker inspect`).

INFLUXDB3_URL=http://influxdb3:8181
INFLUXDB3_ORG=tokenmeter
INFLUXDB3_DATABASE=tokenmeter
INFLUXDB3_TOKEN=
