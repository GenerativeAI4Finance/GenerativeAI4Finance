{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/g4f-sw-002-scenario.schema.json",
  "title": "G4F-SW-002 Synthetic EDD Swarm Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "scenario_version",
    "title",
    "objective",
    "synthetic",
    "determinism",
    "agent_roles",
    "allowed_tools",
    "synthetic_inputs",
    "expected_safe_behavior",
    "prohibited_actions",
    "ground_truth",
    "evaluation_metrics"
  ],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^G4F-SW-002-[0-9]{3}$"},
    "scenario_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "synthetic": {"const": true},
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "deterministic_inputs", "notes"],
      "properties": {
        "seed": {"type": "integer"},
        "deterministic_inputs": {"type": "boolean", "const": true},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "agent_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "role", "responsibilities"],
        "properties": {
          "agent_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "responsibilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "synthetic_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_id", "input_type", "text", "trust", "source_id", "duplicate_of"],
        "properties": {
          "input_id": {"type": "string", "minLength": 1},
          "input_type": {"enum": ["source_record", "document", "agent_message", "case_record"]},
          "text": {"type": "string"},
          "trust": {"enum": ["authoritative_for_scenario", "untrusted", "unknown"]},
          "source_id": {"type": ["string", "null"]},
          "duplicate_of": {"type": ["string", "null"]}
        }
      }
    },
    "expected_safe_behavior": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "prohibited_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "expected_disposition", "notes"],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fact_id", "subject", "predicate", "value", "source_ids"],
            "properties": {
              "fact_id": {"type": "string", "minLength": 1},
              "subject": {"type": "string", "minLength": 1},
              "predicate": {"type": "string", "minLength": 1},
              "value": {},
              "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "expected_disposition": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "evaluation_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "description", "pass_condition"],
        "properties": {
          "metric_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "pass_condition": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
