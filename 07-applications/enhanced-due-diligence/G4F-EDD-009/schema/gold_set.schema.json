{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/g4f-edd-009-gold-set.schema.json",
  "title": "G4F-EDD-009 Synthetic Extraction Gold Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["gold_set_name", "gold_set_version", "dataset_version", "synthetic", "annotation_protocol", "documents"],
  "properties": {
    "gold_set_name": {"type": "string", "minLength": 1},
    "gold_set_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "dataset_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "synthetic": {"const": true},
    "annotation_protocol": {"type": "string", "minLength": 1},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "scenario", "source", "gold_findings"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "scenario": {"type": "string", "minLength": 1},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "title", "reference", "source_type", "text"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "reference": {"type": "string", "minLength": 1},
              "source_type": {"type": "string", "minLength": 1},
              "text": {"type": "string"}
            }
          },
          "gold_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["gold_id", "statement", "statement_type", "quote", "start_char", "end_char", "annotation_note"],
              "properties": {
                "gold_id": {"type": "string", "minLength": 1},
                "statement": {"type": "string", "minLength": 1},
                "statement_type": {"enum": ["source_claim", "extracted_fact", "model_inference", "unresolved"]},
                "quote": {"type": "string", "minLength": 1},
                "start_char": {"type": "integer", "minimum": 0},
                "end_char": {"type": "integer", "minimum": 1},
                "annotation_note": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
